# Required for accounts + persistent storage (Neon/PostgreSQL).
# Use a dedicated database/branch for this app.
DATABASE_URL=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Exact origin: https://your-checklist.vercel.app (or your own domain).
BETTER_AUTH_URL=

# Optional AI: choose OpenAI directly OR AI Gateway. Keys stay server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-4.1-mini
AI_DAILY_LIMIT=30

# Optional live shopping. Imports work without these values.
SERPAPI_API_KEY=
SHOPPING_SEARCH_ENABLED=false
SHOPPING_DAILY_LIMIT=20
